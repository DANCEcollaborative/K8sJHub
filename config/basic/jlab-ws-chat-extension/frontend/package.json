{
  "name": "jlab-ws-chat-extension",
  "version": "0.1.0",
  "description": "WebSocket chat extension for JupyterLab using Socket.IO",
  "scripts": {
    "build": "tsc && webpack --config webpack.config.cjs",
    "prebuild": "jlpm run build",
    "watch": "webpack --watch --config webpack.config.cjs",
    "install-json": "node build-install-json.mjs"
  },
  "jupyterlab": {
    "extension": "lib/index",
    "prebuiltExtension": true,
    "outputDir": "lib"
  },
  "packageManager": "jlpm",
  "resolutions": {
    "@lumino/widgets": "2.7.1"
  },
  "peerDependencies": {
    "@jupyterlab/application": "4.4.3",
    "@jupyterlab/apputils": "4.5.4",
    "@jupyterlab/codeeditor": "4.4.4",
    "@jupyterlab/coreutils": "6.4.4",
    "@jupyterlab/docregistry": "4.4.4",
    "@jupyterlab/launcher": "4.4.3",
    "@jupyterlab/nbformat": "4.4.4",
    "@jupyterlab/observables": "5.4.4",
    "@jupyterlab/rendermime": "4.4.4",
    "@jupyterlab/rendermime-interfaces": "3.12.4",
    "@jupyterlab/services": "7.4.4",
    "@jupyterlab/settingregistry": "4.4.4",
    "@jupyterlab/statedb": "4.4.4",
    "@jupyterlab/statusbar": "4.4.4",
    "@jupyterlab/translation": "4.4.4",
    "@jupyterlab/ui-components": "4.4.4",
    "@lumino/widgets": "2.7.1"
  },
  "dependencies": {
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "socket.io-client": "^4.7.5"
  },
  "devDependencies": {
    "@jupyterlab/application": "4.4.3",
    "@jupyterlab/apputils": "4.5.4",
    "@jupyterlab/extension-builder": "0.12.0",
    "@jupyterlab/launcher": "4.4.3",
    "@jupyterlab/ui-components": "4.4.4",
    "@lumino/algorithm": "1.9.0",
    "@lumino/disposable": "1.7.2",
    "@lumino/messaging": "1.6.0",
    "@lumino/properties": "1.5.2",
    "@lumino/signaling": "1.9.0",
    "@lumino/widgets": "2.7.1",
    "@types/socket.io-client": "^1.4.36",
    "raw-loader": "^4.0.2",
    "ts-loader": "^9.4.4",
    "typescript": "^5.4.5",
    "webpack": "^5.91.0",
    "webpack-cli": "^4.10.0"
  },
  "type": "module",
  "files": [
    "lib",
    "style",
    "schema",
    "static"
  ]
}
