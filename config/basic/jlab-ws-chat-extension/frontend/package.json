{
  "name": "jlab-ws-chat-extension",
  "version": "0.1.0",
  "description": "WebSocket chat extension for JupyterLab using Socket.IO",
  "main": "lib/index.js",
  "type": "module",
  "scripts": {
    "build": "tsc && webpack --config webpack.config.cjs",
    "prebuild": "jlpm run install-json",
    "watch": "webpack --watch --config webpack.config.cjs",
    "install-json": "node build-install-json.mjs"
  },
  "jupyterlab": {
    "extension": true,
    "prebuiltExtension": true,
    "outputDir": "lib",
    "themePath": "style/index.css"
  },
  "packageManager": "jlpm",
  "resolutions": {
    "@lumino/widgets": "2.7.1"
  },
  "peerDependencies": {
    "@jupyterlab/application": "^4.0.0",
    "@jupyterlab/apputils": "^4.0.0",
    "@jupyterlab/codeeditor": "^4.0.0",
    "@jupyterlab/coreutils": "^4.0.0",
    "@jupyterlab/docregistry": "^4.0.0",
    "@jupyterlab/launcher": "^4.0.0",
    "@jupyterlab/nbformat": "^4.0.0",
    "@jupyterlab/observables": "^4.0.0",
    "@jupyterlab/rendermime": "^4.0.0",
    "@jupyterlab/rendermime-interfaces": "^3.0.0",
    "@jupyterlab/services": "^6.0.0",
    "@jupyterlab/settingregistry": "^4.0.0",
    "@jupyterlab/statedb": "^4.0.0",
    "@jupyterlab/statusbar": "^4.0.0",
    "@jupyterlab/translation": "^4.0.0",
    "@jupyterlab/ui-components": "^4.0.0",
    "@lumino/algorithm": "^2.0.0",
    "@lumino/disposable": "^2.0.0",
    "@lumino/messaging": "^2.0.0",
    "@lumino/properties": "^2.0.0",
    "@lumino/signaling": "^2.0.0",
    "@lumino/widgets": "^2.0.0"
  },
  "dependencies": {
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "socket.io-client": "^4.7.5"
  },
  "devDependencies": {
    "@jupyterlab/application": "^4.0.0",
    "@jupyterlab/apputils": "^4.0.0",
    "@jupyterlab/extension-builder": "0.12.0",
    "@jupyterlab/launcher": "^4.0.0",
    "@jupyterlab/ui-components": "^4.0.0",
    "@lumino/algorithm": "^2.0.0",
    "@lumino/disposable": "^2.0.0",
    "@lumino/messaging": "^2.0.0",
    "@lumino/properties": "^2.0.0",
    "@lumino/signaling": "^2.0.0",
    "@lumino/widgets": "^2.0.0",
    "@types/react": "^18.2.0",
    "@types/react-dom": "^18.2.0",
    "raw-loader": "^4.0.2",
    "ts-loader": "^9.4.4",
    "typescript": "^5.4.5",
    "webpack": "^5.91.0",
    "webpack-cli": "^4.10.0"
  },
  "files": [
    "lib",
    "style",
    "schema",
    "static"
  ]
}
