    "@jupyterlab/builder": "^4.0.0",
    "rimraf": "^5.0.1",
    "typescript": "^5.0.0"
  },
  "jupyterlab": {
    "extension": true,
    "outputDir": "../jlab_chat_ext/labextension"
  },
  "publishConfig": {
