{
  "name": "jlab-chat-ext",
  "version": "0.1.0",
  "description": "JupyterLab extension for chat",
  "keywords": ["jupyter", "jupyterlab", "jupyterlab-extension"],
  "homepage": "https://github.com/DANCEcollaborative/jlab-chat-ext",
  "bugs": {
    "url": "https://github.com/DANCEcollaborative/jlab-chat-ext/issues"
  },
  "license": "BSD-3-Clause",
  "author": "Chas Murray <rcmurray@andrew.cmu.edu>",
  "files": ["lib/**/*.{d.ts,js,js.map}", "style/index.css"],
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "style": "style/index.css",
  "repository": {
    "type": "git",
    "url": "https://github.com/DANCEcollaborative/jlab-chat-ext.git"
  },
  "scripts": {
    "build": "jupyter labextension build .",
    "clean": "rimraf lib tsconfig.tsbuildinfo",
    "watch": "jupyter labextension watch ."
  },
  "dependencies": {
    "@jupyterlab/application": "^4.0.0",
    "@jupyterlab/apputils": "^4.0.0"
