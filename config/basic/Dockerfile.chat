FROM jupyter/base-notebook:latest

# Copy backend/frontend early so caches work
COPY backend /home/jovyan/backend
COPY frontend /home/jovyan/frontend

# Ensure core JupyterLab packages are up-to-date
RUN pip install --no-cache-dir --upgrade \
    jupyterlab==4.4.3 \
    jupyterhub==5.2.1 \
    jupyter-collaboration \
    jupyterlab-link-share \
    jupyterlab_pygments
 
USER root

RUN apt-get update \
 && apt-get install -y nodejs npm curl \
 && corepack enable \
 && corepack prepare yarn@stable --activate \
 && chown -R ${NB_UID}:${NB_GID} /home/jovyan/frontend

WORKDIR /home/jovyan/frontend

# Install extension dependencies including socket.io-client
RUN yarn install && yarn add socket.io-client

# Build the extension
RUN yarn run build \
 || cat /tmp/jupyterlab-debug-*.log

# Install the extension into JupyterLab
RUN pip install .


# Install chat extension from pip (prebuilt for Lab v4)
RUN pip install jupyterlab_ws_chat 

WORKDIR /home/jovyan

# Back-end startup
RUN echo 'node /home/jovyan/backend/server.js &' \
  >> /etc/profile.d/start-chat.sh \
  && chmod +x /etc/profile.d/start-chat.sh

# Shared volume
RUN mkdir -p /home/jovyan/shared \
  && chown -R jovyan:users /home/jovyan/shared

USER ${NB_UID}