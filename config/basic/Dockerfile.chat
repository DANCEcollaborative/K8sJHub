FROM jupyter/base-notebook:latest

# Step 1: Root setup — install Node.js 20 and Yarn
USER root

RUN apt-get update && apt-get install -y curl gnupg && \
    curl -fsSL https://deb.nodesource.com/setup_20.x | bash - && \
    apt-get install -y nodejs && \
    npm install -g yarn && \
    apt-get clean && rm -rf /var/lib/apt/lists/*

# Step 2: Install JupyterLab + required packages
RUN pip install --no-cache-dir --upgrade \
    jupyterlab==4.4.3 \
    jupyterhub==5.2.1 \
    jupyter-collaboration \
    jupyterlab-link-share \
    jupyter-server-ydoc \
    jupyter-ydoc

# Step 3: Copy frontend and build extension
USER jovyan
WORKDIR /home/jovyan/frontend

COPY frontend/package.json frontend/yarn.lock ./
COPY frontend/tsconfig.json ./
COPY frontend/src ./src
COPY frontend/style ./style

# optional: include webpack config if needed
COPY frontend/webpack.config.cjs ./webpack.config.cjs

# Configure Yarn and build extension
RUN echo "nodeLinker: node-modules" > .yarnrc.yml && \
    yarn install && \
    yarn build

# Step 4: Copy Python backend and install extension package
WORKDIR /home/jovyan

COPY pyproject.toml .
COPY frontend/install.json ./install.json
COPY README.md .
COPY jlab_ws_chat_extension ./jlab_ws_chat_extension

RUN pip install --no-cache-dir --user .

# Step 5: Build final JupyterLab assets
ENV JUPYTERLAB_DIR=/home/jovyan/.local/share/jupyter/lab

RUN jupyter lab build --dev-build=False --minimize=False

# Step 6: Final prep
WORKDIR /home/jovyan
RUN mkdir -p /home/jovyan/shared && chown -R jovyan:users /home/jovyan/shared

# Reaffirm environment variable for chat URL at runtime
ENV CHAT_WS_URL=${CHAT_WS_URL:-http://localhost:3001}
