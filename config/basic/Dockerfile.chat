FROM jupyter/base-notebook:latest

### Step 1: Install Node.js 20 and Yarn
USER root
RUN apt-get update && apt-get install -y curl gnupg && \
    curl -fsSL https://deb.nodesource.com/setup_20.x | bash - && \
    apt-get install -y nodejs && \
    npm install -g yarn && \
    apt-get clean && rm -rf /var/lib/apt/lists/*

### Step 2: Install JupyterLab and dependencies
RUN pip install --no-cache-dir --upgrade \
    jupyterlab==4.4.3 \
    jupyterhub==5.2.1 \
    jupyter-collaboration \
    jupyterlab-link-share \
    jupyter-server-ydoc \
    jupyter-ydoc

### Step 3: Copy frontend and build it
COPY frontend /home/jovyan/frontend
COPY frontend/webpack.config.cjs /home/jovyan/frontend/webpack.config.cjs
WORKDIR /home/jovyan/frontend
RUN rm -rf node_modules yarn.lock && \
    echo "nodeLinker: node-modules" > .yarnrc.yml && \
    yarn install && \
    yarn build --stats-error-details

### Step 4: Fix frontend output for JupyterLab (package.json and install.json)
# Assumes build output is in ../jlab_ws_chat_extension/labextension/
WORKDIR /home/jovyan
RUN mkdir -p jlab_ws_chat_extension/labextension && \
    cp -r frontend/install.json jlab_ws_chat_extension/labextension/install.json && \
    cp frontend/package.json jlab_ws_chat_extension/labextension/package.json

### Step 5: Copy backend and install extension with pip
COPY pyproject.toml README.md jlab_ws_chat_extension.json ./
COPY jlab_ws_chat_extension ./jlab_ws_chat_extension
RUN pip install .

### Step 6: Install frontend into JupyterLab
RUN jupyter labextension install ./jlab_ws_chat_extension/labextension --no-build

### Step 7: Copy install.json to JupyterLab extensions folder
RUN mkdir -p /opt/conda/share/jupyter/labextensions/jlab-ws-chat-extension && \
    cp frontend/install.json /opt/conda/share/jupyter/labextensions/jlab-ws-chat-extension/install.json

### Step 8: Final build
RUN jupyter lab build --dev-build=False --minimize=False

### Step 9: Final setup
RUN mkdir -p /home/jovyan/shared && chown -R jovyan:users /home/jovyan/shared
ENV CHAT_WS_URL=${CHAT_WS_URL:-http://localhost:3001}

USER jovyan
WORKDIR /home/jovyan
