FROM jupyter/base-notebook:latest

# Step 1: Install Node.js 20 and NPM (no Yarn)
USER root
RUN apt-get update && apt-get install -y curl gnupg && \
    curl -fsSL https://deb.nodesource.com/setup_20.x | bash - && \
    apt-get install -y nodejs && \
    apt-get clean && rm -rf /var/lib/apt/lists/*

# Step 2: Install JupyterLab and required packages
RUN pip install --no-cache-dir --upgrade \
    jupyterlab==4.4.3 \
    jupyterhub==5.2.1 \
    jupyter-collaboration \
    jupyterlab-link-share \
    jupyter-server-ydoc \
    jupyter-ydoc

# Step 3: Copy frontend and build it with npm
COPY frontend /home/jovyan/frontend
COPY frontend/webpack.config.cjs /home/jovyan/frontend/webpack.config.cjs
WORKDIR /home/jovyan/frontend
RUN rm -rf node_modules package-lock.json && \
    npm install && \
    npm run build

# Step 4: Prepare labextension folder
WORKDIR /home/jovyan
RUN mkdir -p jlab_ws_chat_extension/labextension && \
    cp frontend/install.json jlab_ws_chat_extension/labextension/install.json && \
    cp frontend/package.json jlab_ws_chat_extension/labextension/package.json
#     cp frontend/package.json jlab_ws_chat_extension/labextension/package.json && \
#     cp -r frontend/lib jlab_ws_chat_extension/labextension/lib

# Step 5: Copy and install Python backend
COPY pyproject.toml README.md ./
COPY jlab_ws_chat_extension ./jlab_ws_chat_extension
RUN pip install .

# Step 6: Final JupyterLab rebuild
RUN jupyter lab clean && jupyter lab build --dev-build=False --minimize=False || (cat /tmp/jupyterlab-debug-*.log && exit 1)
RUN cat /tmp/jupyterlab-debug-*.log || echo "No debug log found"

# Step 7: Environment setup
RUN mkdir -p /home/jovyan/shared && chown -R jovyan:users /home/jovyan/shared
ENV CHAT_WS_URL=${CHAT_WS_URL:-http://localhost:3001}

USER jovyan
WORKDIR /home/jovyan
