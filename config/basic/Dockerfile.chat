FROM jupyter/base-notebook:latest

USER root

# Install Node.js + Yarn (for building the JupyterLab extension)
RUN apt-get update \
 && apt-get install -y curl \
 && curl -fsSL https://deb.nodesource.com/setup_20.x | bash - \
 && apt-get install -y nodejs \
 && corepack enable \
 && corepack prepare yarn@stable --activate

# Copy and install frontend (JupyterLab extension)
COPY frontend /home/jovyan/frontend
WORKDIR /home/jovyan/frontend
RUN yarn install
RUN yarn run build || cat /tmp/jupyterlab-debug-*.log

# Optionally install the extension into JupyterLab if it exports a Python package too
RUN pip install .

# Upgrade core JupyterLab & install collaboration tools
RUN pip install --no-cache-dir --upgrade \
    jupyterlab==4.4.3 \
    jupyterhub==5.2.1 \
    jupyter-collaboration \
    jupyterlab-link-share \
    jupyterlab_pygments \
    jupyterlab_ws_chat

# Shared volume setup
RUN mkdir -p /home/jovyan/shared \
 && chown -R jovyan:users /home/jovyan/shared

USER ${NB_UID}
WORKDIR /home/jovyan
