FROM jupyter/base-notebook:latest

ARG CACHEBUST=1

# Copy backend/frontend early so caches work
# COPY backend /home/jovyan/backend
COPY frontend /home/jovyan/frontend

# Ensure core JupyterLab packages are up-to-date
RUN pip install --no-cache-dir \
    jupyterlab==4.4.3 \
    jupyterhub==5.2.1 \
    jupyter-collaboration \
#     jupyterlab-link-share \
#     jupyterlab_pygments \
  	&& pip uninstall -y jupyterlab-link-share || true \
  	&& pip install --upgrade jupyterlab-link-share jupyterlab_pygments

USER root
RUN apt-get update \
 && apt-get install -y nodejs npm curl \
 && corepack enable \
 && corepack prepare yarn@stable --activate \
 && chown -R ${NB_UID}:${NB_GID} /home/jovyan/frontend

USER ${NB_UID}
WORKDIR /home/jovyan/frontend

# tsconfig.json is already included in the frontend directory copied earlier
# Create tsconfig.json for TypeScript output
# RUN echo '{\n  "compilerOptions": {\n    "target": "ES2017",\n    "module": "ESNext",\n    "moduleResolution": "Node",\n    "outDir": "lib",\n    "rootDir": "src",\n    "strict": true,\n    "esModuleInterop": true,\n    "skipLibCheck": true,\n    "forceConsistentCasingInFileNames": true,\n    "declaration": true,\n    "sourceMap": true\n  },\n  "include": ["src"]\n}' > tsconfig.json


# Install extension dependencies including socket.io-client
RUN yarn install && yarn add socket.io-client

# Build the extension
RUN yarn run build || cat /tmp/jupyterlab-debug-*.log

# Use prebuilt extension packaging (skip deprecated labextension install)
WORKDIR /home/jovyan
USER root

# Install the prebuilt frontend extension via pip
RUN pip install ./frontend

# Shared volume
RUN mkdir -p /home/jovyan/shared \
  && chown -R jovyan:users /home/jovyan/shared

USER ${NB_UID}
