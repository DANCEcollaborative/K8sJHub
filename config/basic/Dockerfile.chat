FROM jupyter/base-notebook:latest

# Step 1: Root setup — install Node.js 20 and Yarn
USER root

RUN apt-get update && apt-get install -y curl gnupg && \
    curl -fsSL https://deb.nodesource.com/setup_20.x | bash - && \
    apt-get install -y nodejs && \
    npm install -g yarn && \
    apt-get clean && rm -rf /var/lib/apt/lists/*

# Ensure jovyan can write build output
RUN chown -R jovyan:users /home/jovyan

# Step 2: Install JupyterLab + required packages
RUN pip install --no-cache-dir --upgrade \
    jupyterlab==4.4.3 \
    jupyterhub==5.2.1 \
    jupyter-collaboration \
    jupyterlab-link-share \
    jupyter-server-ydoc \
    jupyter-ydoc

# Step 3: Copy frontend and build extension
# USER jovyan
COPY frontend /home/jovyan/frontend
WORKDIR /home/jovyan/frontend

# optional: include webpack config if needed
COPY frontend/webpack.config.cjs ./webpack.config.cjs

# Configure Yarn and build extension
RUN echo "nodeLinker: node-modules" > .yarnrc.yml && \
    yarn install && \
    yarn build

# Step 4: Copy Python backend and install extension package
WORKDIR /home/jovyan

COPY pyproject.toml .
# COPY frontend/install.json ./install.json
COPY frontend/install.json ./jlab_ws_chat_extension/labextension/install.json
COPY README.md .
COPY jlab_ws_chat_extension ./jlab_ws_chat_extension
COPY jlab_ws_chat_extension.json /etc/jupyter/jupyter_server_config.d/jlab_ws_chat_extension.json


USER jovyan
# RUN pip install ./jlab_ws_chat_extension
# RUN pip install . 
RUN pip install . --verbose


# Step 5: Build final JupyterLab assets
ENV JUPYTERLAB_DIR=/home/jovyan/.local/share/jupyter/lab

RUN jupyter lab build --dev-build=False --minimize=False

# Step 6: Final prep
WORKDIR /home/jovyan
RUN mkdir -p /home/jovyan/shared && chown -R jovyan:users /home/jovyan/shared

# Copy labextension assets to where JupyterLab expects them
RUN mkdir -p ~/.local/share/jupyter/labextensions/jlab-ws-chat-extension && \
    cp -r /home/jovyan/jlab_ws_chat_extension/labextension/* ~/.local/share/jupyter/labextensions/jlab-ws-chat-extension/

# USER ${NB_UID}  # Switch to non-root user

# Reaffirm environment variable for chat URL at runtime
ENV CHAT_WS_URL=${CHAT_WS_URL:-http://localhost:3001}
