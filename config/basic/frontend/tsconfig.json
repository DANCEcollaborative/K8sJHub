{
  "compilerOptions": {
    "lib": ["es2020", "dom"],
    "module": "esnext",
    "target": "es2020",
    "moduleResolution": "node",
    "types": ["node"],
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true,
    "allowSyntheticDefaultImports": true,
    "resolveJsonModule": true,
    "outDir": "lib" 
  },
  "include": ["src/**/*"]
}
